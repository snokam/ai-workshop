<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>aiworkshop</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aiworkshop</name>
    <description>aiworkshop</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <langchain4j.version>1.18.1</langchain4j.version>
        <test.groups.excluded>evaluation,portability</test.groups.excluded>
        <test.groups.included/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Serves the JSON API the React frontend talks to. Also brings multipart upload. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- LangChain4j core: AI services, document loaders/parsers/splitters, embeddings -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- Gemini on Google Cloud Vertex AI -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-vertex-ai-gemini</artifactId>
        </dependency>

        <!-- Azure AI Foundry: the /openai/v1 endpoint is OpenAI-compatible -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-anthropic</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <!-- EXIF and friends, for the fraud check that asks where an image came from -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                The evaluations call a real model, so they are kept out of the ordinary test run:
                `./mvnw test` needs no credentials and costs nothing. They are tagged rather than
                @Disabled so that one command can turn them on, and the tags are driven by properties
                because a profile overriding a plugin's <excludedGroups> in place does not take.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.groups.excluded}</excludedGroups>
                    <groups>${test.groups.included}</groups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            ./mvnw test -Pevaluate — task 4's two evaluations, and only those.

            The <includes> matters as much as the tag: surefire's default patterns are *Test / Tests
            / TestCase, so a class called SomethingEvaluation is never even scanned. Widening the
            scan and letting the tag do the selecting is what makes one command enough.
        -->
        <profile>
            <id>evaluate</id>
            <properties>
                <test.groups.excluded>none</test.groups.excluded>
                <test.groups.included>evaluation</test.groups.included>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ./mvnw test -Pcheck-models — will the workshop run on a model other than the default? -->
        <profile>
            <id>check-models</id>
            <properties>
                <test.groups.excluded>none</test.groups.excluded>
                <test.groups.included>portability</test.groups.included>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>